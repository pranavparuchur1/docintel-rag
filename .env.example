# --- Required ---------------------------------------------------------------
# SEC EDGAR requires a descriptive User-Agent: "Your Name your.email@domain.com"
# https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT="Pranav Paruchuri pranav.paruchuri6@gmail.com"

# --- Database ----------------------------------------------------------------
# Host port 5433 is used on the host to avoid colliding with any local Postgres.
# Inside docker compose the app container uses db:5432 (set in docker-compose.yml).
DATABASE_URL=postgresql://docintel:docintel@localhost:5433/docintel

# --- Pluggable backends (all defaults are local + free) -----------------------
VECTOR_BACKEND=pgvector            # pgvector | lancedb
EMBEDDING_PROVIDER=local           # local (sentence-transformers, CPU) | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OPENAI_API_KEY=                  # only needed if EMBEDDING_PROVIDER=openai

# --- Storage -----------------------------------------------------------------
DATA_DIR=./data                    # raw filings land under DATA_DIR/raw/<accession>
